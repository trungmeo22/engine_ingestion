  {
    "unit_id": "su_0009",
    "unit_index": 8,
    "document_id": "doc_27d02c37fced9e21",
    "unit_type": "paragraph",
    "classification": "content",
    "content_hash": "c612f4d13bd8184e56a7c925c207d5c2ecc95c6fc0fc9229237c2409d2e67c30",
    "text": "Among patients with heart failure and a reduced ejection fraction, the risk of worsening heart failure or death from cardiovascular causes was lower among those who received dapagliflozin than among those who received placebo, regardless of the presence or absence of diabetes.",
    "table_data": null,
