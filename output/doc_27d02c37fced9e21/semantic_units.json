  {
    "unit_id": "su_0005",
    "unit_index": 4,
    "document_id": "doc_27d02c37fced9e21",
    "unit_type": "paragraph",
    "classification": "clinical_marker",
    "content_hash": "9d490968089bfbf0f95814589b78acb9e55e7302bb883991c84d4201c4bc92a8",
    "text": "In this phase 3, placebo-controlled, randomized controlled trial, we randomly assigned 4744 patients with NYHA class II, III, or IV heart failure and an ejection fraction of 40% or less to receive either dapagliflozin (at a dose of 10 mg once daily) or matching placebo.",
    "table_data": null,
    "section_id": "sec_2",
    "heading_level": null,
    "breadcrumb": "2. Methods",
