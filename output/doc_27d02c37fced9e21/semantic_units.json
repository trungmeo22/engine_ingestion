  {
    "unit_id": "su_0007",
    "unit_index": 6,
    "document_id": "doc_27d02c37fced9e21",
    "unit_type": "paragraph",
    "classification": "content",
    "content_hash": "8b998948839960b88a2f0a50789b89a3bfa379e86eb34ee1a76e8ffba796e20e",
    "text": "Over a median of 18.2 months, the primary outcome occurred in 386 of 2373 patients (16.3%) in the dapagliflozin group and in 502 of 2371 patients (21.2%) in the placebo group (hazard ratio, 0.74; 95% confidence interval [CI], 0.65 to 0.85; P<0.001).",
    "table_data": null,
    "section_id": "sec_3",
    "heading_level": null,
