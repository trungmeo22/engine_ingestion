  {
    "unit_id": "su_0014",
    "unit_index": 13,
    "document_id": "doc_06ca79869efce63a",
    "unit_type": "paragraph",
    "classification": "content",
    "content_hash": "9ab78266d7c13b6bb7b2471ff7b40eaaa786ecc06c799a43ca9504cc616a1064",
    "text": "The quadruple therapy consisting of ACE-I/ARNI, beta-blocker, MRA, and SGLT2 inhibitor is recommended as foundational therapy for all patients with HFrEF.",
    "table_data": null,
    "section_id": "sec_4_1",
    "heading_level": null,
    "breadcrumb": "4. Pharmacological treatments for heart failure with reduced ejection fraction > 4.1. Disease-modifying drug therapy",
    "provenance": {
      "document_id": "doc_06ca79869efce63a",
      "file_name": "ESC_Guidelines_for_the_Management_of_Heart_Failure_2023.txt",
      "page": 1,
