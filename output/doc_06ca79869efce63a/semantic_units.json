    "unit_id": "su_0016",
    "unit_index": 15,
    "document_id": "doc_06ca79869efce63a",
    "unit_type": "paragraph",
    "classification": "clinical_marker",
    "content_hash": "1d7acfd509ef08903e4272046c46d0f8c7e31b9639e2ebcdaddb996d002ac6bb",
    "text": "Dapagliflozin or empagliflozin is recommended for patients with HFrEF to reduce the risk of HF hospitalization and cardiovascular death (Class I, Level A).",
    "table_data": null,
    "section_id": "sec_4_1_1",
    "heading_level": null,
    "breadcrumb": "4. Pharmacological treatments for heart failure with reduced ejection fraction > 4.1. Disease-modifying drug therapy > 4.1.1. Sodium-glucose co-transporter 2 inhibitors",
    "provenance": {
